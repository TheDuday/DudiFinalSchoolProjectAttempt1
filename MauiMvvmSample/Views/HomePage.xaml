<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMvvmSample.Views.HomePage"
             Title="Home">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Text="{Binding User.Username}" 
               Grid.Column="2"/>

        <!-- Email -->
        <Label Text="{Binding User.Email}"
               TextColor="Blue"
               FontAttributes="Italic">
            <Label.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding EditEmailCommand}" />
            </Label.GestureRecognizers>
        </Label>

        <!-- Phone -->
        <Label Text="{Binding User.Phone}"
               TextColor="Blue"
               FontAttributes="Italic"
                Grid.Column="4">
            <Label.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding EditPhoneCommand}" />
            </Label.GestureRecognizers>
        </Label>


        <Button Text="host game" 
                Command = "{Binding GoToHostGameSettingsCommand}"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Grid.Row="1"
                Grid.RowSpan="2"/>


        <Button Text="join game" 
                Command = "{Binding GoToJoinGameCommand}"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Grid.Row="3"
                Grid.RowSpan="2"/>
    </Grid>
</ContentPage>

