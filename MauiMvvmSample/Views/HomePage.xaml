<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMvvmSample.Views.HomePage"
             Title="Home">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Text="{Binding SessionData.user.Username}" 
               Grid.Column="2"/>

        <!-- Email -->
        <Label Text="{Binding SessionData.user.Email}"
               TextColor="Blue">
        </Label>

        <!-- Phone -->
        <Label Text="{Binding SessionData.user.Phone}"
               TextColor="Blue"
                Grid.Column="4">
        </Label>


        <Button Text="host game" 
                Command = "{Binding GoToHostGameSettingsCommand}"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Grid.Row="1"
                Grid.RowSpan="2"/>


        <Button Text="join game" 
                Command = "{Binding GoToJoinGameCommand}"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Grid.Row="4"
                Grid.RowSpan="2"/>
    </Grid>
</ContentPage>

