<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMvvmSample.Views.JoinGamePage"
             Title="JoinGamePage">
    <VerticalStackLayout>
        <Label Text="Enter Game Code: " FontSize="24"/>
        <Entry Text="{Binding GameCode}" Placeholder="Get game code from host, then enter here."/>
        <Button Text="join game with code" Command="{Binding JoinGameWithCodeCommand}"/>
    </VerticalStackLayout>
</ContentPage>