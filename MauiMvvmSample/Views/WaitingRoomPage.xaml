<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMvvmSample.Views.WaitingRoomPage"
             Title="WaitingRoomPage">
    <Grid Padding="20" RowSpacing="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Column="1" Grid.ColumnSpan="3"
               Text="Room Code:"/>
        <Label Grid.Column="1" Grid.ColumnSpan="3"
               Grid.Row="1" Grid.RowSpan="3"
               Text="{Binding GameData.GameId}"
               FontSize="24"/>
    </Grid>
</ContentPage>