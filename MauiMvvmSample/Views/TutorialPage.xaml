<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMvvmSample.Views.TutorialPage"
             Title="TutorialPage">
    <ScrollView>
        <VerticalStackLayout Padding="20">

            <Label Text="Game Tutorial" 
           FontSize="24"/>

            <Label Text="{Binding TutorialString}" 
           FontSize="16" 
           LineHeight="1.3" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>